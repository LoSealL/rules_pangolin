# Runnable Pangolin demo programs (they open a window; not cc_tests).

# Pangolin is a C++17 library (CMAKE_CXX_STANDARD 17 upstream); consumers
# must compile with C++17 too.
CXX17_COPTS = select({
    "@platforms//os:windows": [
        "/std:c++17",
        "/utf-8",
    ],
    "//conditions:default": ["-std=c++17"],
})

cc_binary(
    name = "plot3d",
    srcs = ["plot3d.cc"],
    copts = CXX17_COPTS,
    deps = ["@pangolin//:pangolin"],
)

cc_binary(
    name = "interactive",
    srcs = ["interactive.cc"],
    copts = CXX17_COPTS,
    deps = ["@pangolin//:pangolin"],
)
