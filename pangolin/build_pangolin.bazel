# Bazel overlay for Pangolin v0.9.3 (https://github.com/stevenlovegrove/Pangolin),
# applied via git_repository(build_file = ...) in pangolin/repositories.bzl.
#
# The upstream project is built with CMake; this file mirrors its per-component
# target graph (components/*/CMakeLists.txt) as cc_library targets with the
# CMake code generation steps (embedded fonts/shaders, factory registry
# headers) replaced by the gen_embed tool from the sibling pangolin_tools
# repository.
#
# Platform policy follows upstream CMake:
#   - Windows: Win32 windowing + GLEW (built from source in @glew)
#   - Linux:   X11/EGL windowing + system libepoxy (headers and lib come
#              from the system; requires libepoxy-dev/libegl-dev/libx11-dev)
# Optional image/video codec backends (png/jpeg/tiff/openexr/lz4/zstd/raw,
# ffmpeg, realsense, ...) are disabled, matching a CMake build where none of
# those packages are found. Only the C++ libraries are built - pango_python
# is intentionally excluded.

load("@pangolin_tools//:embed.bzl", "embed_binary_files", "embed_shader_files", "factory_registry_header")

package(default_visibility = ["//visibility:public"])

WINDOWS = "@platforms//os:windows"

CXX17_COPTS = select({
    WINDOWS: [
        "/std:c++17",
        "/bigobj",
        "/utf-8",
        "/Zc:__cplusplus",
    ],
    "//conditions:default": [
        "-std=c++17",
        "-pthread",
    ],
})

# ---------------------------------------------------------------------------
# Generated sources (upstream: cmake/EmbedBinaryFiles.cmake, EmbedShaderFiles.cmake)
# ---------------------------------------------------------------------------

embed_binary_files(
    name = "gen_pango_fonts",
    srcs = ["components/pango_opengl/src/fonts/AnonymousPro.ttf"],
    out = "gen/pango_opengl/fonts.cpp",
)

embed_shader_files(
    name = "gen_pango_shaders",
    srcs = glob(["components/pango_opengl/shaders/*.glsl*"]),
    out = "gen/pango_opengl/shaders.cpp",
    prefix = "components/pango_opengl/shaders",
)

# ---------------------------------------------------------------------------
# Generated factory registry headers (upstream: cmake/PangolinFactory.cmake).
# Keys must match the PANGOLIN_REGISTER_FACTORY symbols compiled on each OS.
# ---------------------------------------------------------------------------

factory_registry_header(
    name = "gen_window_factories",
    interface = "WindowInterface",
    factories = select({
        WINDOWS: ["WinWindow"],
        "//conditions:default": ["X11Window"],
    }),
    out = "gen/pangolin/factory/RegisterFactoriesWindowInterface.h",
)

factory_registry_header(
    name = "gen_video_factories",
    interface = "VideoInterface",
    factories = [
        "TestVideo",
        "ImagesVideo",
        "SplitVideo",
        "TruncateVideo",
        "PangoVideo",
        "DebayerVideo",
        "ShiftVideo",
        "TransformVideo",
        "UnpackVideo",
        "PackVideo",
        "JoinVideo",
        "MergeVideo",
        "JsonVideo",
        "MjpegVideo",
    ] + select({
        WINDOWS: [],
        # shared_memory.cpp (unix-only source) also defines
        # RegisterSharedMemoryVideoFactory; upstream never calls it.
        "//conditions:default": ["ThreadVideo"],
    }),
    out = "gen/pangolin/factory/RegisterFactoriesVideoInterface.h",
)

factory_registry_header(
    name = "gen_video_output_factories",
    interface = "VideoOutputInterface",
    factories = [
        "ImagesVideoOutput",
        "PangoVideoOutput",
    ],
    out = "gen/pangolin/factory/RegisterFactoriesVideoOutputInterface.h",
)

