        # Link against the system X11/EGL runtime libraries by soname; no
        # -dev packages required (headers come from @libx11/@xorgproto/
        # @egl_registry).
        "//conditions:default": [
            "-l:libX11.so.6",
            "-l:libEGL.so.1",
        ],
    }),
    deps = [
        ":pango_core",
        ":pango_opengl",
    ] + select({
        WINDOWS: [],
        "//conditions:default": [
            "@egl_registry//:egl_headers",
            "@libx11//:x11_headers",
            "@xorgproto//:x11_proto_headers",
