        "components/pango_opengl/src/opengl_render_state.cpp",
        ":gen_pango_fonts",
        ":gen_pango_shaders",
    ],
    hdrs = glob([
        "components/pango_opengl/include/**/*.h",
        "components/pango_opengl/include/**/*.hpp",
    ], allow_empty = True) + [
        # vendored stb header included directly from src/
        "components/pango_opengl/src/stb_truetype.h",
    ],
    includes = ["components/pango_opengl/include"],
    copts = CXX17_COPTS,
    # Upstream picks libepoxy on Linux and GLEW elsewhere; rules_pangolin
    # uses GLEW on every OS (see build_glew.bazel).
    defines = [
        "HAVE_EIGEN",
        "HAVE_GLEW",
    ],
    deps = [
        ":pango_core",
        ":pango_image",
        "@eigen3//:eigen",
        "@glew//:glew",
    ] + select({
        # glplatform.h includes <GL/gl.h> on non-GLES platforms; on Windows
        # this header comes from the Windows SDK.
        WINDOWS: [],
        "//conditions:default": ["@glvnd//:gl_legacy_headers"],
    }),
)

