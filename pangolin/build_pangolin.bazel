    hdrs = glob([
        "components/pango_windowing/include/**/*.h",
        "components/pango_windowing/include/**/*.hpp",
    ], allow_empty = True) + [":gen_window_factories"],
    includes = [
        "components/pango_windowing/include",
        "gen",
    ],
    copts = CXX17_COPTS,
    defines = select({
        WINDOWS: ['PANGO_DEFAULT_WIN_URI=\\"winapi\\"'],
        "//conditions:default": ['PANGO_DEFAULT_WIN_URI=\\"x11\\"'],
    }),
    linkopts = select({
        WINDOWS: [
            "/DEFAULTLIB:user32.lib",
            "/DEFAULTLIB:gdi32.lib",
